# MongoDB connection string without trailing slash or database name
# (The application automatically appends '/secondbrain' in src/database/database.ts)
# Example: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# Secret key used to sign and verify JWT tokens
JWT_SECRET=your_jwt_secret_key

# ─── Redis Configuration (Distributed Rate Limiting) ─────────────────────────
# Redis connection URL (Supports standard redis:// or Upstash/TLS rediss://)
# Example: redis://127.0.0.1:6379 or rediss://default:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379

# Alternatively, configure host, port, password independently:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_USERNAME=
# REDIS_TLS=false

# ─── Reverse Proxy Configuration ─────────────────────────────────────────────
# Trust reverse proxy hop count or CIDR range (e.g. 1 for Render / Vercel / Cloudflare)
TRUST_PROXY=1

# ─── Rate Limiting Limits & Window Overrides ──────────────────────────────────
# Global Redis key namespace prefix
RATE_LIMIT_PREFIX=rl

# Login: 10 requests / minute / IP
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000

# Signup: 5 requests / 10 minutes / IP
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_SIGNUP_WINDOW_MS=600000

# Forgot Password: 5 requests / 10 minutes / IP
RATE_LIMIT_FORGOT_PW_MAX=5
RATE_LIMIT_FORGOT_PW_WINDOW_MS=600000

# Reset Password: 5 requests / 10 minutes / IP
RATE_LIMIT_RESET_PW_MAX=5
RATE_LIMIT_RESET_PW_WINDOW_MS=600000

# AI Endpoints: 30 requests / minute / IP
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_AI_WINDOW_MS=60000

# General Authenticated API: 100 requests / minute / IP
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000

# Auth Redis outage policy (true = fail closed with 503; false = fail open)
RATE_LIMIT_AUTH_FAIL_CLOSED=true
